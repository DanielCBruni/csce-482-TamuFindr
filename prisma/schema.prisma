generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ItemType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  MATCHED
  RESOLVED
  CANCELLED
}

// Constants for Matching Algorithm
enum PrimaryColor {
  BLACK
  WHITE
  SILVER
  GRAY
  RED
  BLUE
  GREEN
  YELLOW
  BROWN
  PURPLE
  PINK
  ORANGE
  OTHER
}

enum ItemCondition {
  UNKNOWN
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum MatchStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  items Item[]
}

model Location {
  id           String  @id @default(cuid())
  name         String  @unique
  abbreviation String? @unique

  // Location for matching algorithm
  latitude  Float?
  longitude Float?

  items        Item[] @relation("ItemLocation")
  storageItems Item[] @relation("StorageLocation")
}

model Item {
  id          String     @id @default(cuid())
  userId      String
  categoryId  String
  type        ItemType
  status      ItemStatus @default(OPEN)
  title       String
  description String?

  // Standardized Constant Attributes
  primaryColor   PrimaryColor
  secondaryColor PrimaryColor?
  brand          String? // Normalized lowercase string
  condition      ItemCondition

  // Location & Spatial Data
  // LocationId = where it was found
  locationId           String
  locationExtra        String?
  storageLocationId    String?
  storageLocationExtra String?

  incidentDate    DateTime
  servicedById    String?
  resolvedDate    DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  submitter       User        @relation("ItemSubmitter", fields: [userId], references: [id], onDelete: Restrict)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location        Location    @relation("ItemLocation", fields: [locationId], references: [id], onDelete: Restrict)
  storageLocation Location?   @relation("StorageLocation", fields: [storageLocationId], references: [id], onDelete: SetNull)
  servicedBy      User?       @relation("ItemServicer", fields: [servicedById], references: [id], onDelete: SetNull)
  images          ItemImage[]

  // Matches
  lostMatches  ItemMatch[] @relation("LostItemMatches")
  foundMatches ItemMatch[] @relation("FoundItemMatches")

  @@index([userId])
  @@index([categoryId])
  @@index([status, type])
  @@index([incidentDate])
  @@index([locationId])
  @@index([primaryColor])
}

model ItemMatch {
  id               String      @id @default(cuid())
  lostItemId       String
  potentialMatchId String
  score            Float // Score from 0.0 to 1.0 (or 0 to 100)
  scoreDetails     Json? // Stores calculation breakdown: { category: 1.0, distance: 0.85, ... }
  status           MatchStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  lostItem       Item @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  potentialMatch Item @relation("FoundItemMatches", fields: [potentialMatchId], references: [id], onDelete: Cascade)

  // Ensure a lost item and candidate match pair is unique
  // Indexes for query performance
  @@unique([lostItemId, potentialMatchId])
  @@index([lostItemId])
  @@index([potentialMatchId])
  @@index([status, score])
}

model ItemImage {
  id         String   @id @default(cuid())
  itemId     String
  imageKey   String
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Better Auth Required Models

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  phoneNumber    String?
  role           UserRole @default(USER)
  submittedItems Item[]   @relation("ItemSubmitter")
  servicedItems  Item[]   @relation("ItemServicer")

  ssoproviders SsoProvider[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}
